<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:background="@color/white"
    android:layout_height="match_parent"
    tools:context=".ui.activities.ChangeLanguageActivity">
    <include
        android:id="@+id/includedTab"
        layout="@layout/inner_bar" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/arabicButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="32dp"
        android:fontFamily="@font/cairo_bold"
        android:text="عربي"
        android:textAlignment="viewStart"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:backgroundTint="@color/orange"
        app:icon="@drawable/jordan_circle"
        app:iconPadding="16dp"
        app:iconSize="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/includedTab" />

    <ImageView
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_marginStart="20dp"
        android:src="@drawable/jordan_circle"
        app:layout_constraintBottom_toBottomOf="@id/arabicButton"
        app:layout_constraintStart_toStartOf="@id/arabicButton"
        app:layout_constraintTop_toTopOf="@id/arabicButton" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/englishButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="32dp"
        android:fontFamily="@font/cairo_bold"
        android:text="English"
        android:textAlignment="viewStart"
        android:textColor="@color/white"
        android:backgroundTint="@color/orange"
        android:textSize="18sp"
        app:icon="@drawable/jordan_circle"
        app:iconPadding="16dp"
        app:iconSize="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/arabicButton" />

    <ImageView
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_marginStart="20dp"
        android:src="@drawable/english_icon"
        app:layout_constraintBottom_toBottomOf="@id/englishButton"
        app:layout_constraintStart_toStartOf="@id/englishButton"
        app:layout_constraintTop_toTopOf="@id/englishButton" />
</androidx.constraintlayout.widget.ConstraintLayout>