<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".ui.activities.AddAddressActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include
            android:id="@+id/includedTab"
            layout="@layout/inner_bar" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/includedTab">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/cairo_bold"
                android:text="@string/choose_location_from_map"
                android:textColor="@color/orange"
                android:textSize="15sp" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/custom_edit_text">

                <TextView
                    android:id="@+id/mapLocation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/empty_edit_text"
                    android:fontFamily="@font/cairo_bold"
                    android:hint="*"
                    android:singleLine="true"
                    android:textColor="#7F7F7F"
                    android:textColorHint="#87010C"
                    android:textSize="11sp"
                    app:layoutDescription="@id/ownerNameET"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/mapIcon"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/mapIcon"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginEnd="20sp"
                    android:src="@drawable/crosshair"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/orange" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/cairo_bold"
                android:text="@string/choose_your_location_manually"
                android:textColor="#9F9F9F"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/cairo_bold"
                android:text="@string/address_name"
                android:textColor="@color/orange"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/titleEt"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@drawable/custom_edit_text"
                android:fontFamily="@font/cairo_regular"
                android:paddingHorizontal="16dp"
                tools:text="Waleed"
                android:textColor="@color/black_text"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/cairo_bold"
                android:text="@string/city"
                android:textColor="@color/orange"
                android:textSize="15sp" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/custom_city_et">

                <Spinner
                    android:id="@+id/sectorCity"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/empty_edit_text"
                    android:fontFamily="@font/cairo_bold"
                    android:paddingStart="15sp"
                    android:paddingEnd="15sp"
                    android:singleLine="true"
                    android:textColor="#7F7F7F"
                    android:textSize="16sp"
                    app:layoutDescription="@id/ownerNameET"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />


            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/cairo_bold"
                android:text="@string/area"
                android:textColor="@color/orange"
                android:textSize="15sp" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/custom_edit_text">

                <Spinner
                    android:id="@+id/sectorArea"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/empty_edit_text"
                    android:fontFamily="@font/cairo_bold"
                    android:paddingStart="15sp"
                    android:paddingEnd="15sp"
                    android:singleLine="true"
                    android:textColor="#7F7F7F"
                    android:textSize="16sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/cairo_bold"
                android:text="@string/address_in_detail"
                android:textColor="@color/orange"
                android:textSize="15sp" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/custom_edit_text">

                <EditText
                    android:id="@+id/addressInDetailEt"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@drawable/empty_edit_text"
                    android:fontFamily="@font/cairo_bold"
                    android:padding="15dp"
                    android:singleLine="true"
                    android:textColor="#7F7F7F"
                    android:textSize="16sp"
                    app:layoutDescription="@id/establishmentNameET"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/uploadePhotContainer"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/custom_edit_text"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/empty_edit_text"
                    android:fontFamily="@font/cairo_bold"
                    android:paddingStart="15sp"
                    android:paddingEnd="15sp"
                    android:singleLine="true"
                    android:text="@string/your_shop_s_photo"
                    android:textColor="#7F7F7F"
                    android:textSize="12sp"
                    app:layoutDescription="@id/establishmentNameET"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:id="@+id/uplPhto"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/custom_edit_text"
                    android:backgroundTint="@color/orange"
                    android:gravity="center"
                    android:padding="10dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/btnimgdone"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="5dp"
                        android:backgroundTint="@color/white"
                        android:src="@drawable/upload" />

                    <TextView
                        android:id="@+id/txtphto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/upload"
                        android:textColor="@color/white"
                        android:textSize="12sp"

                        />

                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/orange"
                android:fontFamily="@font/cairo_bold"
                android:text="@string/save"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:cornerRadius="25dp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>