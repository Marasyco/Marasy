<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/white"
    tools:context=".ui.activities.MyLocationsActivity">

    <include
        android:id="@+id/includedTab"
        layout="@layout/inner_bar" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/addAddress"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/cairo_bold"
        android:text="@string/add_new_address"
        android:textColor="@color/white"
        android:backgroundTint="@color/orange"
        android:textSize="16sp"
        app:iconGravity="textEnd"
        app:iconPadding="16dp"
        app:iconSize="20dp"
        app:iconTint="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/includedTab" />

    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:id="@+id/locationsRv"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/addAddress"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="8dp"
        tools:listitem="@layout/address_item"/>
</androidx.constraintlayout.widget.ConstraintLayout>